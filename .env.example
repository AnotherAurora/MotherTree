# Supabase — required for database access
NEXT_PUBLIC_SUPABASE_URL=https://brsxrctacuhllumnfwgx.supabase.co

# Public / browser-safe — anon (legacy JWT) or publishable (sb_publishable_...)
# Used by the public SELECT-only read path (RLS allowlist). Never a secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local admin only. Required for /admin, /tables, /path-carver, /simulator.
# Never set this (or the service role key) on Vercel.
ADMIN_ENABLED=true

# Server-only — Secret (sb_secret_...) OR legacy service_role JWT
# Dashboard → Project Settings → API keys → Secret / service_role
# Never use the publishable/anon key here. Admin CRUD only. Local .env.local only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias for the new Secret key name:
# SUPABASE_SECRET_KEY=
